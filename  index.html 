<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kiss</title>
  <style>
    html, body { height: 100%; margin: 0; }
    body { background:#0f0f1a; overflow:hidden; cursor:pointer; }
    .center { position: fixed; inset: 0; display: grid; place-items: center; }
    .kiss-btn { font-size: 90px; user-select: none; transition: transform .2s; line-height: 1; }
    .kiss-btn:hover { transform: scale(1.15); }
    .particle { position: fixed; font-size: 24px; pointer-events:none; animation: floatUp 2s ease-out forwards; line-height:1; }
    @keyframes floatUp {
      0% { opacity: 1; transform: translate(0,0) scale(1); }
      100% { opacity: 0; transform: translate(var(--x), var(--y)) scale(2); }
    }
  </style>
</head>
<body>
  <div class="center"><div class="kiss-btn" id="btn">💋</div></div>
  <script>
    const items = ['💋','💖','❤️','✨','😘','💕'];
    function createHearts(x, y) {
      for (let i = 0; i < 15; i++) {
        const p = document.createElement('div');
        p.className = 'particle';
        p.innerText = items[Math.floor(Math.random() * items.length)];
        p.style.left = x + 'px';
        p.style.top  = y + 'px';
        p.style.setProperty('--x', (Math.random()-0.5)*300 + 'px');
        p.style.setProperty('--y', (Math.random()-0.8)*300 + 'px');
        document.body.appendChild(p);
        setTimeout(() => p.remove(), 2000);
      }
    }
    document.getElementById('btn').addEventListener('click', (e) => createHearts(e.clientX, e.clientY));
    document.body.addEventListener('click', (e) => {
      if (e.target && e.target.id === 'btn') return;
      createHearts(e.clientX, e.clientY);
    });
  </script>
</body>
</html>
